# Local prototype configuration template.
# Copy to .env and replace every placeholder with a value from your own test account.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
OPENAI_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Your Name <you@your-verified-domain.com>
PROTOTYPE_MODE=true
PROTOTYPE_DAILY_SEND_LIMIT=25
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/google/oauth/callback
