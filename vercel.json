{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/partner-portal",
      "has": [{ "type": "host", "value": "connectem.ai" }],
      "destination": "https://go.connectem.ai/partner-portal",
      "permanent": false
    },
    {
      "source": "/partner-portal",
      "has": [{ "type": "host", "value": "www.connectem.ai" }],
      "destination": "https://go.connectem.ai/partner-portal",
      "permanent": false
    },
    {
      "source": "/partner-portal.html",
      "has": [{ "type": "host", "value": "connectem.ai" }],
      "destination": "https://go.connectem.ai/partner-portal",
      "permanent": false
    },
    {
      "source": "/partner-portal.html",
      "has": [{ "type": "host", "value": "www.connectem.ai" }],
      "destination": "https://go.connectem.ai/partner-portal",
      "permanent": false
    },
    {
      "source": "/go",
      "has": [{ "type": "host", "value": "connectem.ai" }],
      "destination": "https://go.connectem.ai/partner-portal",
      "permanent": false
    },
    {
      "source": "/go",
      "has": [{ "type": "host", "value": "www.connectem.ai" }],
      "destination": "https://go.connectem.ai/partner-portal",
      "permanent": false
    },
    {
      "source": "/admin",
      "has": [{ "type": "host", "value": "connectem.ai" }],
      "destination": "https://admin.connectem.ai/",
      "permanent": false
    },
    {
      "source": "/admin",
      "has": [{ "type": "host", "value": "www.connectem.ai" }],
      "destination": "https://admin.connectem.ai/",
      "permanent": false
    },
    {
      "source": "/admin.html",
      "has": [{ "type": "host", "value": "connectem.ai" }],
      "destination": "https://admin.connectem.ai/",
      "permanent": false
    },
    {
      "source": "/admin.html",
      "has": [{ "type": "host", "value": "www.connectem.ai" }],
      "destination": "https://admin.connectem.ai/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "go.connectem.ai" }],
      "destination": "/partner-portal",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [{ "type": "host", "value": "go.connectem.ai" }],
      "destination": "/partner-portal",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "connectem.ai" }],
      "destination": "/landing.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.connectem.ai" }],
      "destination": "/landing.html"
    },
    {
      "source": "/index.html",
      "has": [{ "type": "host", "value": "connectem.ai" }],
      "destination": "/landing.html"
    },
    {
      "source": "/index.html",
      "has": [{ "type": "host", "value": "www.connectem.ai" }],
      "destination": "/landing.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "admin.connectem.ai" }],
      "destination": "/index.html"
    },
    {
      "source": "/landing",
      "destination": "/landing.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/prospects",
      "destination": "/index.html"
    },
    {
      "source": "/admin/influencers",
      "destination": "/index.html"
    },
    {
      "source": "/admin/outreach",
      "destination": "/index.html"
    },
    {
      "source": "/admin/events",
      "destination": "/index.html"
    },
    {
      "source": "/admin/settings",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/influencers",
      "destination": "/index.html"
    },
    {
      "source": "/prospects",
      "destination": "/index.html"
    },
    {
      "source": "/outreach",
      "destination": "/index.html"
    },
    {
      "source": "/events",
      "destination": "/index.html"
    },
    {
      "source": "/settings",
      "destination": "/index.html"
    },
    {
      "source": "/partner-portal",
      "destination": "/partner-portal.html"
    },
    {
      "source": "/partner-portal/inbox",
      "destination": "/partner-portal.html"
    },
    {
      "source": "/partner-portal/email",
      "destination": "/partner-portal.html"
    },
    {
      "source": "/partner-portal/settings",
      "destination": "/partner-portal.html"
    },
    {
      "source": "/go",
      "destination": "/partner-portal.html"
    },
    {
      "source": "/marketplace",
      "destination": "/marketplace.html"
    },
    {
      "source": "/opt-in",
      "destination": "/opt-in.html"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.svg"
    },
    {
      "source": "/api/",
      "destination": "/api/index?route=health"
    },
    {
      "source": "/api",
      "destination": "/api/index?route=health"
    },
    {
      "source": "/app-config.js",
      "destination": "/api/index?route=app-config.js"
    },
    {
      "source": "/_python",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/oidc?route=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.clerk.accounts.dev https://*.clerk.com https://accounts.google.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://*.clerk.accounts.dev https://*.clerk.com https://api.openai.com https://generativelanguage.googleapis.com https://api.explorium.ai https://*.googleapis.com https://*.firebaseio.com https://api.twilio.com https://api.linkedin.com https://api.resend.com https://api.lemlist.com; frame-src 'self' https://*.clerk.accounts.dev https://*.clerk.com https://accounts.google.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self';" }
      ]
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    },
    "api/oidc.js": {
      "maxDuration": 60
    }
  }
}
