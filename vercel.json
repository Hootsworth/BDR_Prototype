{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/partner-portal",
      "has": [{ "type": "host", "value": "connectem.ai" }],
      "destination": "https://go.connectem.ai/partner-portal",
      "permanent": false
    },
    {
      "source": "/partner-portal",
      "has": [{ "type": "host", "value": "www.connectem.ai" }],
      "destination": "https://go.connectem.ai/partner-portal",
      "permanent": false
    },
    {
      "source": "/partner-portal.html",
      "has": [{ "type": "host", "value": "connectem.ai" }],
      "destination": "https://go.connectem.ai/partner-portal",
      "permanent": false
    },
    {
      "source": "/partner-portal.html",
      "has": [{ "type": "host", "value": "www.connectem.ai" }],
      "destination": "https://go.connectem.ai/partner-portal",
      "permanent": false
    },
    {
      "source": "/admin",
      "has": [{ "type": "host", "value": "connectem.ai" }],
      "destination": "https://admin.connectem.ai/",
      "permanent": false
    },
    {
      "source": "/admin",
      "has": [{ "type": "host", "value": "www.connectem.ai" }],
      "destination": "https://admin.connectem.ai/",
      "permanent": false
    },
    {
      "source": "/admin.html",
      "has": [{ "type": "host", "value": "connectem.ai" }],
      "destination": "https://admin.connectem.ai/",
      "permanent": false
    },
    {
      "source": "/admin.html",
      "has": [{ "type": "host", "value": "www.connectem.ai" }],
      "destination": "https://admin.connectem.ai/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "go.connectem.ai" }],
      "destination": "/partner-portal",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [{ "type": "host", "value": "go.connectem.ai" }],
      "destination": "/partner-portal",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "connectem.ai" }],
      "destination": "/landing.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.connectem.ai" }],
      "destination": "/landing.html"
    },
    {
      "source": "/index.html",
      "has": [{ "type": "host", "value": "connectem.ai" }],
      "destination": "/landing.html"
    },
    {
      "source": "/index.html",
      "has": [{ "type": "host", "value": "www.connectem.ai" }],
      "destination": "/landing.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "admin.connectem.ai" }],
      "destination": "/index.html"
    },
    {
      "source": "/landing",
      "destination": "/landing.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/partner-portal",
      "destination": "/partner-portal.html"
    },
    {
      "source": "/marketplace",
      "destination": "/marketplace.html"
    },
    {
      "source": "/opt-in",
      "destination": "/opt-in.html"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.svg"
    },
    {
      "source": "/api/",
      "destination": "/api/index?route=health"
    },
    {
      "source": "/api",
      "destination": "/api/index?route=health"
    },
    {
      "source": "/app-config.js",
      "destination": "/api/index?route=app-config.js"
    },
    {
      "source": "/api/proxy/:path*",
      "destination": "https://api.explorium.ai/:path*"
    },
    {
      "source": "/_python",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/oidc?route=:path*"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    },
    "api/oidc.js": {
      "maxDuration": 60
    }
  }
}
